{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinglobstertours",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true,
  },

  // Vite build output. Requests that match a file here are served directly;
  // anything else reaches worker/index.ts, which routes the API paths and
  // falls back to env.ASSETS for client-side (SPA) routes.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  "kv_namespaces": [
    {
      "binding": "KV_LOBSTER",
      "id": "7c817e9b46874439b681fd488628b79c",
    },
  ],

  // Secrets are NOT kept here — set with `wrangler secret put <NAME>`:
  //   CLOUDINARY_API_SECRET  (signed image uploads)
  //   INIT_DATA_SECRET       (guards POST /init-data)
  "vars": {
    "ADMIN_PASSWORD": "kinglobster",
    "CLOUDINARY_CLOUD_NAME": "dkxlhxpe4",
    "CLOUDINARY_API_KEY": "896279918126553",
    "CLOUDINARY_UPLOAD_PRESET": "",
  },
}
